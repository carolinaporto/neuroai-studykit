# Copie para .env e preencha. O .env NUNCA é commitado (ver .gitignore).
# Nenhuma destas variáveis pode ser prefixada com VITE_ — isso as enviaria
# para o bundle do navegador. Ver invariante 3 no CLAUDE.md.

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL_GENERATE=claude-sonnet-4-5
LLM_MODEL_GRADE=claude-sonnet-4-5

# --- banco ---
DATABASE_URL=postgresql+asyncpg://studykit:studykit@localhost:5433/studykit
POSTGRES_USER=studykit
POSTGRES_PASSWORD=studykit
POSTGRES_DB=studykit

# --- app ---
ENV=development
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:5173

# Owner fixo até o M12 existir (auth). UUID qualquer, estável.
DEV_OWNER_ID=00000000-0000-4000-8000-000000000001

# --- orçamento (invariante: teto desde a v1) ---
DAILY_TOKEN_BUDGET=200000
MAX_GRADINGS_PER_DAY=300

# --- auth: só a partir do M12 ---
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# ALLOWED_EMAILS=mporto@college.harvard.edu

# --- storage: só a partir do M13 ---
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
