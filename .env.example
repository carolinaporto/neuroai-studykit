# Copie para .env e preencha. O .env NUNCA é commitado (ver .gitignore).
# Nenhuma destas variáveis pode ser prefixada com VITE_ — isso as enviaria
# para o bundle do navegador. Ver invariante 3 no CLAUDE.md.
# Exceção deliberada: a publishable key da Clerk, no .env do frontend — ver a seção
# de auth abaixo, ela não é segredo, a própria Clerk projeta pra rodar no cliente.

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL_GENERATE=claude-sonnet-5
LLM_MODEL_GRADE=claude-sonnet-5

# --- embeddings (M7 part 2: dedup de item por cosseno do enunciado) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- banco ---
DATABASE_URL=postgresql+asyncpg://studykit:studykit@localhost:5433/studykit
POSTGRES_USER=studykit
POSTGRES_PASSWORD=studykit
POSTGRES_DB=studykit

# --- app ---
ENV=development
# Só usado em produção (M13) — CORS aceita esta origem além do regex de localhost. Vazio em
# dev: o regex sozinho já cobre qualquer porta do Vite. Ver apps/api/main.py.
WEB_ORIGIN=

# Id fixo que todo teste/fixture de dev usa pra semear linhas (packages/ingest/cli.py's
# _ensure_owner). Não é mais como a produção decide quem está logado — isso é a Clerk,
# desde o M12 — mas continua existindo pro `sync`/testes locais.
DEV_OWNER_ID=00000000-0000-4000-8000-000000000001

# --- orçamento (invariante: teto desde a v1) ---
DAILY_TOKEN_BUDGET=200000
MAX_GRADINGS_PER_DAY=300

# --- auth de verdade: Clerk (OIDC + magic link), M12 (ver apps/api/core/auth.py) ---
# Sem valor default de propósito: verificação de sessão falha fechada enquanto
# CLERK_SECRET_KEY não for preenchida, em vez de aceitar qualquer requisição.
CLERK_SECRET_KEY=
# Qual dos e-mails de ALLOWED_EMAILS vira role=owner no primeiro login; os demais viram
# role=student. ALLOWED_EMAILS é quem pode logar de verdade — quem não está na lista não
# cria conta, mesmo tendo a URL (aplicado por este app, não pelo painel da Clerk).
OWNER_EMAIL=
ALLOWED_EMAILS=
