# Copie para apps/web/.env. Ao contrário da raiz do projeto, VITE_* aqui é o normal — é
# assim que o Vite expõe uma variável ao bundle do navegador. A publishable key da Clerk
# não é segredo (a própria Clerk projeta ela pra rodar no cliente); a secret key
# (CLERK_SECRET_KEY) fica só no .env do backend, nunca aqui. Ver invariante 3 no CLAUDE.md.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Endereço da API. Em dev, o padrão em apps/web/src/api/client.ts já cobre localhost:8000 —
# só precisa disso pra apontar pro backend de produção (M13), ex. Render.
VITE_API_BASE_URL=http://localhost:8000
